<div class="capsule-item">
  <% if (item.photo) { %><div class="capsule-photo">
    <img src="<%= prefix %><%= item.photo.url %>" alt="<%= item.category %>" loading="lazy">
    <%- include('photo-credit', { photo: item.photo }) %>
  </div><% } %>
  <h4><%= item.category %></h4>
  <p class="cap-bg"><%= item.background %></p>
  <div class="capsule-meta">
    <div><div class="cap-label">Look For</div><p><%= item.lookFor %></p></div>
    <div><div class="cap-label">How To Wear It</div><p><%= item.pairing %></p></div>
  </div>
  <div class="tier-grid">
    <%- include('tier-card', { label: 'Low', tier: item.tiers.low, shopSearchUrl: shopSearchUrl }) %>
    <%- include('tier-card', { label: 'Mid', tier: item.tiers.mid, shopSearchUrl: shopSearchUrl }) %>
    <%- include('tier-card', { label: 'High', tier: item.tiers.high, shopSearchUrl: shopSearchUrl }) %>
  </div>
</div>
